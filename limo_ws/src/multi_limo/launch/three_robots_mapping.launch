<?xml version="1.0"?>
<launch>
  <!-- 
    Multi-Robot Mapping Launch File
    Run this AFTER launching three_robots.launch
    Terminal 1: roslaunch multi_limo three_robots.launch
    Terminal 2: roslaunch multi_limo three_robots_mapping.launch
  -->

  <!-- Static transforms from world to each robot's map frame -->
  <!-- These use the same initial poses as in map_merge configuration -->
  <node pkg="tf" type="static_transform_publisher" name="world_to_robot1_tf" 
        args="0 0 0 0 0 0 world robot1/map 100"/>
  
  <node pkg="tf" type="static_transform_publisher" name="world_to_robot2_tf" 
        args="0 0 0 0 0 0 world robot2/map 100"/>
  
  <node pkg="tf" type="static_transform_publisher" name="world_to_robot3_tf" 
        args="0 0 0 0 0 0 world robot3/map 100"/>

  <!-- Robot 1 Mapping -->
  <group ns="robot1">
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
      <!-- Input topics -->
      <remap from="scan" to="/robot1/scan"/>
      <remap from="tf" to="/tf"/>
      
      <!-- Output topics -->
      <remap from="map" to="/robot1/map"/>
      <remap from="map_metadata" to="/robot1/map_metadata"/>
      
      <!-- Frame names -->
      <param name="base_frame" value="robot1/base_link"/>
      <param name="odom_frame" value="robot1/odom"/>
      <param name="map_frame" value="robot1/map"/>
      
      <!-- IMPORTANT: Tell gmapping to publish map->odom transform -->
      <param name="transform_publish_period" value="0.05"/>
      
      <!-- Gmapping parameters -->
      <param name="maxUrange" value="10.0"/>
      <param name="maxRange" value="12.0"/>
      <param name="sigma" value="0.05"/>
      <param name="kernelSize" value="1"/>
      <param name="lstep" value="0.05"/>
      <param name="astep" value="0.05"/>
      <param name="iterations" value="5"/>
      <param name="lsigma" value="0.075"/>
      <param name="ogain" value="3.0"/>
      <param name="lskip" value="0"/>
      <param name="minimumScore" value="50"/>
      
      <!-- Map parameters -->
      <param name="srr" value="0.1"/>
      <param name="srt" value="0.2"/>
      <param name="str" value="0.1"/>
      <param name="stt" value="0.2"/>
      <param name="linearUpdate" value="0.2"/>
      <param name="angularUpdate" value="0.1"/>
      <param name="temporalUpdate" value="0.5"/>
      <param name="resampleThreshold" value="0.5"/>
      <param name="particles" value="30"/>
      
      <!-- Map size and resolution -->
      <param name="xmin" value="-20.0"/>
      <param name="ymin" value="-20.0"/>
      <param name="xmax" value="20.0"/>
      <param name="ymax" value="20.0"/>
      <param name="delta" value="0.05"/>
      <param name="llsamplerange" value="0.01"/>
      <param name="llsamplestep" value="0.01"/>
      <param name="lasamplerange" value="0.005"/>
      <param name="lasamplestep" value="0.005"/>
    </node>
  </group>

  <!-- Robot 2 Mapping -->
  <group ns="robot2">
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
      <!-- Input topics -->
      <remap from="scan" to="/robot2/scan"/>
      <remap from="tf" to="/tf"/>
      
      <!-- Output topics -->
      <remap from="map" to="/robot2/map"/>
      <remap from="map_metadata" to="/robot2/map_metadata"/>
      
      <!-- Frame names -->
      <param name="base_frame" value="robot2/base_link"/>
      <param name="odom_frame" value="robot2/odom"/>
      <param name="map_frame" value="robot2/map"/>
      
      <!-- IMPORTANT: Tell gmapping to publish map->odom transform -->
      <param name="transform_publish_period" value="0.05"/>
      
      <!-- Gmapping parameters -->
      <param name="maxUrange" value="10.0"/>
      <param name="maxRange" value="12.0"/>
      <param name="sigma" value="0.05"/>
      <param name="kernelSize" value="1"/>
      <param name="lstep" value="0.05"/>
      <param name="astep" value="0.05"/>
      <param name="iterations" value="5"/>
      <param name="lsigma" value="0.075"/>
      <param name="ogain" value="3.0"/>
      <param name="lskip" value="0"/>
      <param name="minimumScore" value="50"/>
      
      <!-- Map parameters -->
      <param name="srr" value="0.1"/>
      <param name="srt" value="0.2"/>
      <param name="str" value="0.1"/>
      <param name="stt" value="0.2"/>
      <param name="linearUpdate" value="0.2"/>
      <param name="angularUpdate" value="0.1"/>
      <param name="temporalUpdate" value="0.5"/>
      <param name="resampleThreshold" value="0.5"/>
      <param name="particles" value="30"/>
      
      <!-- Map size and resolution -->
      <param name="xmin" value="-20.0"/>
      <param name="ymin" value="-20.0"/>
      <param name="xmax" value="20.0"/>
      <param name="ymax" value="20.0"/>
      <param name="delta" value="0.05"/>
      <param name="llsamplerange" value="0.01"/>
      <param name="llsamplestep" value="0.01"/>
      <param name="lasamplerange" value="0.005"/>
      <param name="lasamplestep" value="0.005"/>
    </node>
  </group>

  <!-- Robot 3 Mapping -->
  <group ns="robot3">
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
      <!-- Input topics -->
      <remap from="scan" to="/robot3/scan"/>
      <remap from="tf" to="/tf"/>
      
      <!-- Output topics -->
      <remap from="map" to="/robot3/map"/>
      <remap from="map_metadata" to="/robot3/map_metadata"/>
      
      <!-- Frame names -->
      <param name="base_frame" value="robot3/base_link"/>
      <param name="odom_frame" value="robot3/odom"/>
      <param name="map_frame" value="robot3/map"/>
      
      <!-- IMPORTANT: Tell gmapping to publish map->odom transform -->
      <param name="transform_publish_period" value="0.05"/>
      
      <!-- Gmapping parameters -->
      <param name="maxUrange" value="10.0"/>
      <param name="maxRange" value="12.0"/>
      <param name="sigma" value="0.05"/>
      <param name="kernelSize" value="1"/>
      <param name="lstep" value="0.05"/>
      <param name="astep" value="0.05"/>
      <param name="iterations" value="5"/>
      <param name="lsigma" value="0.075"/>
      <param name="ogain" value="3.0"/>
      <param name="lskip" value="0"/>
      <param name="minimumScore" value="50"/>
      
      <!-- Map parameters -->
      <param name="srr" value="0.1"/>
      <param name="srt" value="0.2"/>
      <param name="str" value="0.1"/>
      <param name="stt" value="0.2"/>
      <param name="linearUpdate" value="0.2"/>
      <param name="angularUpdate" value="0.1"/>
      <param name="temporalUpdate" value="0.5"/>
      <param name="resampleThreshold" value="0.5"/>
      <param name="particles" value="30"/>
      
      <!-- Map size and resolution -->
      <param name="xmin" value="-20.0"/>
      <param name="ymin" value="-20.0"/>
      <param name="xmax" value="20.0"/>
      <param name="ymax" value="20.0"/>
      <param name="delta" value="0.05"/>
      <param name="llsamplerange" value="0.01"/>
      <param name="llsamplestep" value="0.01"/>
      <param name="lasamplerange" value="0.005"/>
      <param name="lasamplestep" value="0.005"/>
    </node>
  </group>

  <!-- Optional: Launch RViz with the configuration -->
  <arg name="rviz" default="true"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" 
        args="-d $(find multi_limo)/rviz/three_robots.rviz" required="false"/>

</launch>
