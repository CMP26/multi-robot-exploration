      <param name="global_costmap/obstacles/observation_sources" value="scan"/>
      <param name="global_costmap/obstacles/scan/topic" value="/robot2/scan"/>
      <param name="global_costmap/obstacles/scan/sensor_frame" value="robot2/laser_link"/>
      <param name="global_costmap/obstacles/scan/data_type" value="LaserScan"/>
      <param name="global_costmap/obstacles/scan/marking" value="true"/>
      <param name="global_costmap/obstacles/scan/clearing" value="true"/>
      <param name="global_costmap/obstacles/obstacle_range" value="10.0"/>
      <param name="global_costmap/obstacles/raytrace_range" value="12.0"/>
      <param name="global_costmap/inflation/inflation_radius" value="0.5"/>
      
      <param name="local_costmap/global_frame" value="robot2/odom"/>
