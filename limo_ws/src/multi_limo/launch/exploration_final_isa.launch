      <param name="local_costmap/update_frequency" value="10.0"/>
      <param name="local_costmap/publish_frequency" value="5.0"/>
      <param name="local_costmap/rolling_window" value="true"/>
      <param name="local_costmap/width" value="6.0"/>
      <param name="local_costmap/height" value="6.0"/>
      <param name="local_costmap/resolution" value="0.05"/>
      <param name="local_costmap/transform_tolerance" value="1.0"/>
      
      <rosparam param="local_costmap/plugins">
        - {name: obstacles, type: "costmap_2d::ObstacleLayer"}
        - {name: inflation, type: "costmap_2d::InflationLayer"}
      </rosparam>
      
      <param name="local_costmap/obstacles/observation_sources" value="scan"/>
      <param name="local_costmap/obstacles/scan/topic" value="/robot2/scan"/>
      <param name="local_costmap/obstacles/scan/sensor_frame" value="robot2/laser_link"/>
      <param name="local_costmap/obstacles/scan/data_type" value="LaserScan"/>
      <param name="local_costmap/obstacles/scan/marking" value="true"/>
      <param name="local_costmap/obstacles/scan/clearing" value="true"/>
      <param name="local_costmap/obstacles/obstacle_range" value="3.0"/>
      <param name="local_costmap/obstacles/raytrace_range" value="4.0"/>
      <param name="local_costmap/inflation/inflation_radius" value="0.3"/>
      
      <param name="DWAPlannerROS/max_vel_x" value="0.4"/>
      <param name="DWAPlannerROS/min_vel_x" value="0.0"/>
      <param name="DWAPlannerROS/max_vel_theta" value="1.0"/>
      <param name="DWAPlannerROS/min_vel_theta" value="-1.0"/>
      <param name="DWAPlannerROS/acc_lim_x" value="1.0"/>
      <param name="DWAPlannerROS/acc_lim_theta" value="2.0"/>
      <param name="DWAPlannerROS/xy_goal_tolerance" value="0.2"/>
      <param name="DWAPlannerROS/yaw_goal_tolerance" value="0.2"/>
    </node>
    
    <node pkg="explore_lite" type="explore" name="explore" output="screen" launch-prefix="bash -c 'sleep 5; $0 $@'">
      <param name="robot_base_frame" value="robot2/base_link"/>
      <param name="costmap_topic" value="/robot2/move_base/global_costmap/costmap"/>
      <param name="costmap_updates_topic" value="/robot2/move_base/global_costmap/costmap_updates"/>
      <param name="visualize" value="true"/>
      <param name="planner_frequency" value="0.33"/>
      <param name="progress_timeout" value="30.0"/>
      <param name="potential_scale" value="3.0"/>
      <param name="orientation_scale" value="0.0"/>
