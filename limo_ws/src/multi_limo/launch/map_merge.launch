<launch>
    <node pkg="multi_limo" type="merge_map.py" respawn="false" name="map_merge" output="screen">
        <rosparam param="map_topics">["/robot1/map", "/robot2/map", "/robot3/map"]</rosparam>
        <param name="merged_topic" value="/merged_map"/>
        <param name="merge_rate" value="1.0"/>
    </node>
</launch>
