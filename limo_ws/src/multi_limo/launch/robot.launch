<?xml version="1.0"?>
<launch>
  <arg name="gui" default="true"/>
  <arg name="world_file" default="$(find multi_limo)/worlds/room.world"/>
  
  <arg name="robot_x" default="-6.0"/>
  <arg name="robot_y" default="2.0"/>
  <arg name="robot_z" default="0.2"/>
  <arg name="robot_yaw" default="0.0"/>
  
  <env name="GAZEBO_GRAPHICS_QUALITY" value="0"/>
  <env name="LIBGL_ALWAYS_SOFTWARE" value="1"/>
  
  <!-- Launch Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
  </include>

  <!-- CRITICAL: Static transform world to odom (identity transform) -->
  <node pkg="tf" type="static_transform_publisher" name="world_to_odom" 
        args="0 0 0 0 0 0 world odom 100"/>
  
  <!-- Robot description -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find limo_description)/urdf/limo_four_diff.xacro'" />
  
  <!-- Spawn robot at specified position -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -model limo -param robot_description -x $(arg robot_x) -y $(arg robot_y) -z $(arg robot_z) -Y $(arg robot_yaw)"/>
  
  <!-- Robot state publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" value="50.0"/>
  </node>

</launch>