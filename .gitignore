### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-file
*.flf
#Test results file
TestResults.xml
# Catkin build artifacts
/build/
/devel/
/install/
logs/

# Python cache files
*.pyc
*.pyo
__pycache__/

# ROS specific
*.egg-info/
*.swp
*.swo

# Ignore generated maps
/maps/*.pgm
/maps/*.yaml

# Ignore generated URDF/XACRO intermediate files
**/*.urdf~
**/*.xacro~

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE/editor files
.vscode/
.idea/
*.iml

# Ignore backup files
*~
