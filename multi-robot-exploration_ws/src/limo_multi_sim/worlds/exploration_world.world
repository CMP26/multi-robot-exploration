<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="exploration_world">

    <!-- Light + ground plane -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- -----------------------------
         ROOM 1 — left side
         ----------------------------- -->
    <!-- Room 1 Walls -->
    <model name="room1_wall1">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
      <pose>-4 0 1.25 0 0 0</pose>
    </model>

    <model name="room1_wall2">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
      <pose>-4 -4 1.25 0 0 1.57</pose>
    </model>

    <!-- -----------------------------
         ROOM 2 — right side
         ----------------------------- -->
    <!-- Room 2 Walls -->
    <model name="room2_wall1">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
      <pose>4 0 1.25 0 0 0</pose>
    </model>

    <model name="room2_wall2">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
      <pose>4 -4 1.25 0 0 1.57</pose>
    </model>

    <!-- -----------------------------
         Obstacles
         ----------------------------- -->
    <model name="box_obstacle1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
        </visual>
      </link>
      <pose>0 1 0.5 0 0 0</pose>
    </model>

    <model name="box_obstacle2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.8</size></box></geometry>
        </visual>
      </link>
      <pose>2 -2 0.4 0 0 0</pose>
    </model>

  </world>
</sdf>
